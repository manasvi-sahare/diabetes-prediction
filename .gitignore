# Virtual environment
venv/

# Data (large, and reproducible via README download command)
data/*.csv

# Trained model artifacts (large, reproducible by re-running scripts)
models/*.pkl

# Keep small result files (CSVs, PNGs) but ignore anything oversized if added later
figures/*.pkl

# Python cache
__pycache__/
*.pyc

# OS/editor cruft
.DS_Store
.vscode/
*.log